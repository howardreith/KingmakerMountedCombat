<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <KingmakerInstallDir>C:\Path\To\Pathfinder Kingmaker</KingmakerInstallDir>
    <KingmakerManagedDir>$(KingmakerInstallDir)\Kingmaker_Data\Managed</KingmakerManagedDir>
    <!-- The installed loader directory supplies the unchanged legacy Harmony12 reference and runtime checks.
         The product compiles against the separate pinned UMM 0.31.1 reference restored under obj/references;
         Build-Local and direct MSBuild restore missing reference bytes without changing this installation. -->
    <UnityModManagerDir>$(KingmakerManagedDir)\UnityModManager</UnityModManagerDir>
    <!-- Optional, read only by the loader checks (scripts/UmmLoaderContracts.ps1), never by the build.
         UnityModManagerProfile: the reviewed profile of planning/UMM-LOADER-PROFILES.json that the loader in
         UnityModManagerDir must be, for example umm-0.33.0. Leave it out and the checks require the installed
         loader to be one of the reviewed profiles and report which.
         UnityModManagerReferencePaths: further genuine UnityModManager.dll files held outside this repository,
         separated by semicolons, for scripts/Test-UmmLoaderContractChecks.ps1. They are only read. -->
    <!-- <UnityModManagerProfile>umm-0.33.0</UnityModManagerProfile> -->
    <!-- <UnityModManagerReferencePaths>D:\References\umm-0.33.2\UnityModManager.dll</UnityModManagerReferencePaths> -->
  </PropertyGroup>
</Project>
