   Check("old token omitted",()=>RuntimeAutomationHost.Token("{}"));Check("explicit true token",()=>RuntimeAutomationHost.Token("{\"observeWorkingDeserialization\":true}"));
   foreach(var token in new[]{"false","null","1","\"true\"","[true]","{}"}){var copy=token;Check("refuse opt-in token "+copy,()=>Refuse(()=>RuntimeAutomationHost.Token("{\"observeWorkingDeserialization\":"+copy+"}")));}
   Check("refuse case alias",()=>Refuse(()=>RuntimeAutomationHost.Token("{\"ObserveWorkingDeserialization\":true}")));
   Check("refuse duplicate opt-in",()=>Refuse(()=>RuntimeAutomationHost.Token("{\"observeWorkingDeserialization\":true,\"observeWorkingDeserialization\":true}")));
   Check("nested unrelated token ignored",()=>RuntimeAutomationHost.Token("{\"unrelated\":{\"observeWorkingDeserialization\":false}}"));
   Check("old DTO shape omitted",()=>{var r=Request("shape");r.ObserveWorkingDeserialization=null;Need(JObject.Parse(JsonConvert.SerializeObject(r,Json))["observeWorkingDeserialization"]==null);});
   Check("new DTO true shape",()=>Need(JObject.Parse(JsonConvert.SerializeObject(Request("shape-true"),Json))["observeWorkingDeserialization"].Type==JTokenType.Boolean));
   Check("exact new admission",()=>Need(Request("valid").Validate().Count==0));
   foreach(var field in new[]{"PersistenceAlternate","PersistenceCase","PersistenceAreaTarget","PersistenceReplayTargets","OwnedPairs","AcquiredManual","ManualDerived","CumulativeAcquisition","ManualSeed","BootstrapInventory","NativeBootstrap","SmallCalibration","OrdinaryField","OrdinaryAcquisition","Progression"}){var f=field;Check("refuse foreign selection "+f,()=>{var r=Request("foreign-"+f);typeof(RuntimeRequest).GetProperty(f).SetValue(r,new object());Need(r.Validate().Count==1);});}
   Check("refuse alternate load",()=>{var r=Request("foreign-load");r.PersistenceLoad=r.Fixture.Working;Need(r.Validate().Count==1);});
   Check("refuse old schema",()=>{var r=Request("schema");r.SchemaVersion=1;Need(r.Validate().Count==1);});
   Check("refuse false selection",()=>{var r=Request("false");r.ObserveWorkingDeserialization=false;Need(r.Validate().Count==1);});
   Check("refuse foreign family",()=>{var r=Request("family");r.Scenario="chunk7-native-bootstrap";Need(r.Validate().Count==1);});
   Check("refuse non-Working source",()=>{var r=Request("source");r.Fixture.Working.InternalName="foreign";Need(r.Validate().Count==1);});
   Check("guard before observer before exactly one load",()=>{var r=Request("loader-good");var l=Loader(r);l.Start((g,m,s)=>{Need(ReferenceEquals(g,Game.Instance)&&ReferenceEquals(m,g.SaveManager)&&ReferenceEquals(s,m.Descriptor));Trace.Events.Add("observer-owned");});Need(string.Join(",",Trace.Events)=="hash,descriptor-read-boundary,verify-descriptor,hash,observer-owned,callback-register,native-load");Need(!l.LoadCallbackObserved);Game.Instance.SaveManager.Callback();Need(l.LoadCallbackObserved);Refuse(()=>l.Start());});
   Check("descriptor failure precedes observer",()=>{var l=Loader(Request("loader-descriptor"));l.RejectDescriptor=true;Refuse(()=>l.Start((g,m,s)=>Trace.Events.Add("observer")));Need(!Trace.Events.Contains("observer")&&!Trace.Events.Contains("native-load"));});
   Check("second hash failure precedes observer",()=>{var l=Loader(Request("loader-rehash"));l.RejectSecondHash=true;Refuse(()=>l.Start((g,m,s)=>Trace.Events.Add("observer")));Need(!Trace.Events.Contains("observer")&&!Trace.Events.Contains("native-load"));});
   Check("main menu guard precedes observer",()=>{var l=Loader(Request("loader-menu"));Game.Instance.CurrentlyLoadedArea=new object();Refuse(()=>l.Start((g,m,s)=>Trace.Events.Add("observer")));Need(Trace.Events.Count==0);});
   Check("request guard precedes descriptor",()=>{var r=Request("loader-request");var l=Loader(r);r.ForceInvalid=true;Refuse(()=>l.Start());Need(Trace.Events.Count==0);});
   Check("partial install remains owned before callback/load",()=>{var r=Request("install-failure");var l=Loader(r);var h=new RuntimeAutomationHost(r);h.LoadRequests(0);NativeWorkingLoadObserver.FailInstall=true;Refuse(()=>l.Start((g,m,s)=>h.Begin()));Need(h.Owns&&!Trace.Events.Contains("callback-register")&&!Trace.Events.Contains("native-load"));h.GuardDispose();Need(h.Released);});
   Check("native load exception preserved after ownership",()=>{var r=Request("load-exception");var l=Loader(r);var h=new RuntimeAutomationHost(r);h.LoadRequests(0);Game.Instance.UI.MainMenu.Throw=true;Refuse(()=>l.Start((g,m,s)=>h.Begin()));Need(h.Owns&&Trace.Events.Last()=="native-load"&&l.State==WorkingFixtureLoadState.Failed);h.GuardDispose();});
   Check("authorized load with missing first observation retains custody",()=>{Reset();var r=Request("missing-observation");var h=new RuntimeAutomationHost(r);h.Begin();h.LoadRequests(1);h.Finish("FAIL");Need(h.Waiting&&!h.Released&&h.CompletionCalls==0&&NativeWorkingLoadObserver.Last.ReleaseCalls==0);Refuse(()=>h.GuardDispose());});
   Check("task success without callback publishes FAIL with release",()=>{Reset();var r=Request("failed-load");var h=new RuntimeAutomationHost(r);h.Begin();NativeWorkingLoadObserver.Last.Full();h.Finish("FAIL");Need(h.Released&&h.CompletionCalls==1&&h.CompletedStatus=="FAIL");SaveRequest(r);});
   Check("writer failure remains retryable after release",()=>{Reset();var r=Request("writer-retry",false);var s=new WorkingLoadDiagnosticSession(r,Game.Instance,Game.Instance.SaveManager,new SaveInfo());s.Install();NativeWorkingLoadObserver.Last.Full();Need(s.TryRelease(false));try{s.PublishFinal("FAIL",false,false,1,0);throw new Exception("unexpected write");}catch(DirectoryNotFoundException){}Need(!s.FinalWritten);Directory.CreateDirectory(r.EvidenceRoot);s.PublishFinal("FAIL",false,false,1,0);Need(s.FinalWritten);SaveRequest(r);});
   Check("success-shaped projection with actual producer",()=>{Reset();var r=Request("complete-observation");var s=new WorkingLoadDiagnosticSession(r,Game.Instance,Game.Instance.SaveManager,new SaveInfo());s.Install();NativeWorkingLoadObserver.Last.Full();Need(s.TryRelease(false));s.PublishFinal("PASS",true,true,1,0);SaveRequest(r);});
   Check("pending write immutable, faulted task no release",()=>{Reset();var r=Request("faulted-pending");var h=new RuntimeAutomationHost(r);h.Begin();var o=NativeWorkingLoadObserver.Last;o.Start(false);h.Finish("FAIL");var path=Path.Combine(r.EvidenceRoot,WorkingLoadDiagnosticSession.PendingFileName);var original=File.ReadAllBytes(path);h.Tick(20);Need(h.Waiting&&!h.Released&&o.ReleaseCalls==0&&original.SequenceEqual(File.ReadAllBytes(path)));Refuse(()=>h.GuardDispose());h.Tick(300);h.Tick(301);Need(h.DeadlineStopped&&h.Warnings==1&&h.CompletionCalls==0&&!File.Exists(Path.Combine(r.EvidenceRoot,WorkingLoadDiagnosticSession.EvidenceFileName)));var obj=JObject.Parse(JsonConvert.SerializeObject(r,Json));var a=JObject.Parse(File.ReadAllText(path));obj["dllSha256"]=a["dllSha256"];obj["dllMvid"]=a["dllMvid"];File.WriteAllText(Path.Combine(r.EvidenceRoot,"request.json"),obj.ToString());});
   Check("failed unpatch retained then retry succeeds",()=>{Reset();var r=Request("unpatch-retry");var h=new RuntimeAutomationHost(r);h.Begin();var o=NativeWorkingLoadObserver.Last;o.Full();o.UnpatchOkay=false;h.Finish("FAIL");Need(h.Waiting&&!h.Released&&h.CompletionCalls==0);o.UnpatchOkay=true;h.Tick(2);Need(h.Released&&h.CompletionCalls==1&&o.ReleaseCalls==2);SaveRequest(r);});
   for(int which=0;which<6;which++){int w=which;Check("native custody fence "+w,()=>{Reset();var r=Request("fence-"+w);var h=new RuntimeAutomationHost(r);h.Begin();NativeWorkingLoadObserver.Last.Full();if(w<3)h.Fence(w,true);if(w==3)LoadingProcess.Instance.IsLoadingInProcess=true;if(w==4)LoadingProcess.Instance.QueuedNames.Add("queued");if(w==5)KingmakerMountedCombat.Integration.NativePersistenceIsolation.HasPendingWrites=true;h.Finish("FAIL");Need(h.Waiting&&!h.Released&&NativeWorkingLoadObserver.Last.ReleaseCalls==0);if(w<3)h.Fence(w,false);if(w==3)LoadingProcess.Instance.IsLoadingInProcess=false;if(w==4)LoadingProcess.Instance.QueuedNames.Clear();if(w==5)KingmakerMountedCombat.Integration.NativePersistenceIsolation.HasPendingWrites=false;h.Tick(2);Need(h.Released&&h.CompletionCalls==1);});}
