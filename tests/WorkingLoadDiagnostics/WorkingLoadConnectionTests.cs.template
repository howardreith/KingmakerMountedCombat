  private static int pass,fail;private static string output;
  private static readonly JsonSerializerSettings Json=new JsonSerializerSettings{ContractResolver=new CamelCasePropertyNamesContractResolver()};
  private static void Check(string name,Action body){try{body();pass++;Console.WriteLine("PASS "+name);}catch(Exception e){fail++;Console.WriteLine("FAIL "+name+": "+e.Message);}}
  private static void Need(bool value){if(!value)throw new InvalidOperationException("assertion");}
  private static void Refuse(Action action){try{action();}catch(InvalidOperationException){return;}throw new Exception("unexpected acceptance");}
  private static RuntimeRequest Request(string name,bool create=true){
   var root=Path.Combine(output,name);if(create)Directory.CreateDirectory(root);
   return new RuntimeRequest{ObserveWorkingDeserialization=true,EvidenceRoot=root,Fixture=new RuntimeFixtureIdentity{Working=new RuntimeSaveDescriptor{InternalName=RuntimeRequest.WorkingSaveName,FileName="Manual_9_KMC_AUTOMATION_WORKING.zks",Sha256=new string('b',64)}}};
  }
