  private static WorkingFixtureLoader Loader(RuntimeRequest r){Reset();Game.Instance.SaveManager.SavePath=r.EvidenceRoot;var path=Path.Combine(r.EvidenceRoot,r.Fixture.Working.FileName);File.WriteAllText(path,"generated non-archive bytes");var f=new FileInfo(path);r.Fixture.Working.Length=f.Length;r.Fixture.Working.LastWriteTimeUtcTicks=f.LastWriteTimeUtc.Ticks;return new WorkingFixtureLoader(r);}
