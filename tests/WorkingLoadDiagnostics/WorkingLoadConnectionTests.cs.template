 internal sealed class NativeWorkingLoadObserver {
  internal static NativeWorkingLoadObserver Last;internal static bool FailInstall;
  internal readonly WorkingLoadObservation Observation;internal bool LoaderObserved,TaskObserved,TaskSettled,TaskSucceeded;
  internal bool Released=>Observation.Released;internal int ReleaseCalls;internal bool UnpatchOkay=true;
  private readonly object manager,save,loader=new object();private readonly Fields fields=new Fields();
  internal NativeWorkingLoadObserver(Game game,SaveManager manager,SaveInfo save){this.manager=manager;this.save=save;Observation=new WorkingLoadObservation(manager,save,fields,1);Last=this;}
  internal void Install(){Trace.Events.Add("install");if(FailInstall)throw new InvalidOperationException("partial install");}
  internal bool TryRelease(bool busy){ReleaseCalls++;return Observation.TryRelease(busy,i=>UnpatchOkay);}
  internal void Start(bool succeeds){LoaderObserved=true;Observation.LoaderCreated(manager,save,loader,false);TaskObserved=true;TaskSettled=true;TaskSucceeded=succeeds;Observation.TaskReturned(loader,succeeds?Task.FromResult(1):Task.FromException(new InvalidOperationException("native outer fault")));}
  internal void Full(){
   Start(true);var player=new object();var party=new object();fields.Player=player;fields.Scene=party;fields.Entity=new object();
   foreach(var lane in new[]{DocumentLane.Player,DocumentLane.Party}){var callback=new object();var value=lane==DocumentLane.Player?player:party;Observation.SerializerReturned(loader,callback,lane,new object());Observation.ObjectReturned(loader,callback,lane,value);Observation.ObjectAssigned(loader,callback,lane,value);}
   Observation.CrossSceneAssigned(loader,player,party);Observation.BeforeScenePostLoad(loader,player,party);Observation.AfterScenePostLoad(loader,player,party);
  }
  private sealed class Fields:IFieldObservationSource {
   internal object Player,Scene,Entity;private readonly object converter=new object();
   public string MainId(object value)=>"literal-main";public int EntityCount(object value)=>1;public object EntityAt(object value,int i)=>Entity;
   public string EntityId(object value)=>"literal-main";public object HoldingScene(object value)=>Scene;public object CurrentScene(object value)=>Scene;
   public string TypeLabel(object value)=>ReferenceEquals(value,converter)?"Kingmaker.EntitySystem.Persistence.JsonUtility.CollectionConverters.CollectionsConverter":"Generated.Entity";
   public int ConverterCount(object value)=>1;public object ConverterAt(object value,int i)=>converter;public bool IsExactCollectionsConverter(object value)=>ReferenceEquals(value,converter);
   public bool InitializedCollectionsEnablement(object value)=>true;public string ContractResolverType(object value)=>"Generated.Contract";public string ExistingReferenceResolverType(object value)=>null;
  }
 }
